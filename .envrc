# Toolchain (python 3.13, uv, node, git, sqlite) comes from flake.nix.
watch_file flake.nix flake.lock

if declare -f use_flake >/dev/null 2>&1; then
  # nix-direnv is installed: cached, much faster reloads.
  use flake
else
  eval "$(nix print-dev-env)"
fi

# Python deps from backend/uv.lock, into a venv built on the Nix interpreter.
cd backend
uv sync
source .venv/bin/activate
cd ..
